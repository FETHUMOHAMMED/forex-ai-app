#         return await call_next(request)
#     key = request.headers.get("x-api-key")
#     if key != AI_API_KEY:
#         raise HTTPException(status_code=401, detail="Unauthorized")
#     return await call_next(request)


@app.get("/signals")
async def get_signals():
    if not signal_service:
        raise HTTPException(status_code=503, detail="Service not initialized")
    
    signals, version = signal_service.get_signals()
    return {
        'signals': signals,
        'count': len(signals),
        'version': version,
        'last_update': signal_service.last_update,
        'timestamp': datetime.now(timezone.utc).isoformat()
    }


@app.get("/health")
async def health_check():
    if not signal_service:
        return {'status': 'initializing', 'ready': False}
    
    stats = signal_service.get_stats()
    
    if not signal_service.running:
        stats['ready'] = False
        stats['status'] = 'stopped'
    elif stats['total_updates'] == 0:
        stats['ready'] = False
        stats['status'] = 'starting'
    elif stats['failed_updates'] > stats['total_updates'] * 0.5:
        stats['ready'] = True
        stats['status'] = 'degraded'
    else:
        stats['ready'] = True
        stats['status'] = 'healthy'
    
    return stats


@app.get("/signals/{pair}")
async def get_pair_signal(pair: str):
    if not signal_service:
        raise HTTPException(status_code=503, detail="Service not initialized")
    
    signals, _ = signal_service.get_signals()
    for signal in signals:
        if signal.get('pair', '').upper() == pair.upper():
            return {'signal': signal, 'cached': True}
    
    try:
        fresh_signal = signal_service.analyze_pair(pair.upper())
        return {'signal': fresh_signal, 'cached': False}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/version")
async def get_version():
    if not signal_service:
        raise HTTPException(status_code=503, detail="Service not initialized")
    
    _, version = signal_service.get_signals()
    return {'version': version, 'last_update': signal_service.last_update}


def main():

